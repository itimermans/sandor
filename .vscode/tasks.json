{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run sandor backend",
            "type": "shell",
            "command": "${workspaceFolder}/backend/.venv/bin/uvicorn sandor_backend.api.app:app --reload --port 8000",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            },
            "isBackground": true,
            "problemMatcher": [],
            "runOptions": {
                "reevaluateOnRerun": true
            }
        },
        {
            "label": "Stop sandor backend",
            "type": "shell",
            "command": "pkill -f 'uvicorn sandor_backend.api.app' || true",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}