{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run sandor frontend",
            "type": "shell",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "windows": {
                "command": "npm",
                "args": [
                    "run",
                    "dev"
                ],
                "options": {
                    "cwd": "${workspaceFolder}\\frontend"
                }
            },
            "linux": {
                "command": "npm",
                "args": [
                    "run",
                    "dev"
                ],
                "options": {
                    "cwd": "${workspaceFolder}/frontend"
                }
            },
            "osx": {
                "command": "npm",
                "args": [
                    "run",
                    "dev"
                ],
                "options": {
                    "cwd": "${workspaceFolder}/frontend"
                }
            }
        },
        {
            "label": "Stop sandor frontend",
            "type": "shell",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-Command",
                    "Get-NetTCPConnection -LocalPort 5173 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }"
                ]
            },
            "linux": {
                "command": "bash",
                "args": [
                    "-lc",
                    "lsof -ti:5173 | xargs -r kill -9 || true"
                ]
            },
            "osx": {
                "command": "bash",
                "args": [
                    "-lc",
                    "lsof -ti:5173 | xargs -r kill -9 || true"
                ]
            }
        },
        {
            "label": "Run sandor backend",
            "type": "shell",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "windows": {
                "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "uvicorn",
                    "sandor_backend.api.app:app",
                    "--reload",
                    "--port",
                    "8000"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/backend/.venv/bin/python",
                "args": [
                    "-m",
                    "uvicorn",
                    "sandor_backend.api.app:app",
                    "--reload",
                    "--port",
                    "8000"
                ]
            },
            "osx": {
                "command": "${workspaceFolder}/backend/.venv/bin/python",
                "args": [
                    "-m",
                    "uvicorn",
                    "sandor_backend.api.app:app",
                    "--reload",
                    "--port",
                    "8000"
                ]
            },
            "runOptions": {
                "reevaluateOnRerun": true
            }
        },
        {
            "label": "Stop sandor backend",
            "type": "shell",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "windows": {
                "command": "taskkill",
                "args": [
                    "/F",
                    "/IM",
                    "uvicorn.exe"
                ]
            },
            "linux": {
                "command": "pkill",
                "args": [
                    "-f",
                    "uvicorn sandor_backend.api.app"
                ]
            },
            "osx": {
                "command": "pkill",
                "args": [
                    "-f",
                    "uvicorn sandor_backend.api.app"
                ]
            }
        }
    ]
}