{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run sandor backend",
            "type": "shell",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "windows": {
                "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
                "args": [
                    "-m",
                    "uvicorn",
                    "sandor_backend.api.app:app",
                    "--reload",
                    "--port",
                    "8000"
                ]
            },
            "linux": {
                "command": "${workspaceFolder}/backend/.venv/bin/python",
                "args": [
                    "-m",
                    "uvicorn",
                    "sandor_backend.api.app:app",
                    "--reload",
                    "--port",
                    "8000"
                ]
            },
            "osx": {
                "command": "${workspaceFolder}/backend/.venv/bin/python",
                "args": [
                    "-m",
                    "uvicorn",
                    "sandor_backend.api.app:app",
                    "--reload",
                    "--port",
                    "8000"
                ]
            },
            "runOptions": {
                "reevaluateOnRerun": true
            }
        },
        {
            "label": "Stop sandor backend",
            "type": "shell",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "windows": {
                "command": "taskkill",
                "args": [
                    "/F",
                    "/IM",
                    "uvicorn.exe"
                ]
            },
            "linux": {
                "command": "pkill",
                "args": [
                    "-f",
                    "uvicorn sandor_backend.api.app"
                ]
            },
            "osx": {
                "command": "pkill",
                "args": [
                    "-f",
                    "uvicorn sandor_backend.api.app"
                ]
            }
        }
    ]
}